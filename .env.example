# --- Обязательные ---
# Секретный ключ API Mindbox (server-side secretKey). Также принимается MINDBOX_SECRET_KEY.
MINDBOX_API_KEY=
# ID точки интеграции (endpointId) в Mindbox.
MINDBOX_ENDPOINT_ID=

# --- HTTP-транспорт (только при запуске с --http) ---
# Порт HTTP-сервера (по умолчанию 3000).
PORT=3000
# Хост привязки (по умолчанию 127.0.0.1 — не открывать наружу без обратного прокси).
HOST=127.0.0.1
# Опциональный bearer-токен для защиты /mcp (если задан — требуется Authorization: Bearer <token>).
MINDBOX_HTTP_TOKEN=
# Доп. разрешённые Host/Origin для DNS-rebinding защиты (через запятую).
MINDBOX_HTTP_ALLOWED_HOSTS=
MINDBOX_HTTP_ALLOWED_ORIGINS=

# --- Безопасность ---
# Отключить инструмент run_operation (произвольные операции): задайте 0/false/off/no.
MINDBOX_ALLOW_RAW=1

# --- Тюнинг клиента (опционально) ---
# Число повторов при 429/5xx/таймауте (по умолчанию 3).
MINDBOX_MAX_RETRIES=3
# Базовая задержка backoff в мс (по умолчанию 500).
MINDBOX_RETRY_BASE_MS=500
# Таймаут одной попытки в мс (по умолчанию 15000).
MINDBOX_TIMEOUT_MS=15000
